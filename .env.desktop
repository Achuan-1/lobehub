# Copy this file to .env when developing the desktop app.
# Generate a unique value with: openssl rand -base64 32
APP_URL=http://localhost:3015
FEATURE_FLAGS=-check_updates,+pin_list
KEY_VAULTS_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET
DATABASE_URL=postgresql://postgres@localhost:5432/postgres
SEARCH_PROVIDERS=search1api
DESKTOP_BUILD=true
